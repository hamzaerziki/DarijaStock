# --- Core ---
APP_NAME=DarijaStock
ENVIRONMENT=development
DEBUG=false

# --- Database ---
# Local development (PostgreSQL exposed on localhost:5433 by docker-compose
# to avoid clashing with a native PostgreSQL on 5432).
DATABASE_URL=postgresql+psycopg://darjastock:darjastock@localhost:5433/darjastock

# --- Auth / security ---
# IMPORTANT: generate a long random value in production, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=720
JWT_ALGORITHM=HS256

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# --- Business configuration (verify legal rates for your jurisdiction) ---
DEFAULT_TAX_RATE=0.00
CURRENCY=MAD
RESERVE_ON_CONFIRM=true
ALLOW_NEGATIVE_STOCK=false
INVOICE_NUMBER_PREFIX=FA
INVOICE_NUMBER_YEAR_RESET=true

# --- Initial admin (used only by scripts/create_admin.py) ---
ADMIN_EMAIL=admin@darjastock.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrateur
